# Flangx: Tracked Build Assets & Releases

# Ignore everything by default
*

# Allow directories
!*/

# Allow standard documentation
!*.md
!md/
!md/**

# Allow icons, previews, and mods
!assets/
!assets/**
!mods/
!mods/**

# Allow specific build requirements
!src/
!src/**
!requirements.txt

# Allow executables and releases
!*.exe
!*.zip

# EXPLICITLY IGNORE local test scripts and temporary logs
.test_move.cs
*.log
src/interaction_rust/target/
src/interaction_rust/*.pdb
src/interaction_rust/*.obj
.vscode/

# Ensure specialized git folders are handled correctly
.git/
.github/
! .github/**
